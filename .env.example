# Copy this file to `.env` and edit the values you want to change.
#
#     copy .env.example .env
#
# `.env` is gitignored, so it stays on your machine only. Nothing here is a
# secret: this project runs fully offline with local models and needs no API
# keys. Real environment variables always win over values set in this file.

# --- Paths ---------------------------------------------------------------
# Relative paths are resolved from the project root.
BANKING_CHROMA_DIR=chroma_db
BANKING_DATASET=data/raw/banking_knowledge_base_1000.csv

# --- Models --------------------------------------------------------------
BANKING_EMBED_MODEL=all-MiniLM-L6-v2
BANKING_LLM_MODEL=llama3.2:3b
BANKING_COLLECTION=banking_faq

# --- Retrieval -----------------------------------------------------------
# Number of FAQ chunks given to the LLM as context.
BANKING_TOP_K=3

# --- Ollama --------------------------------------------------------------
BANKING_OLLAMA_HOST=http://localhost:11434
# How long Ollama keeps the model in memory between questions.
BANKING_OLLAMA_KEEP_ALIVE=30m

# --- Diagnostics ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
BANKING_LOG_LEVEL=INFO
# Set to 1 to log how long each step takes.
BANKING_TIMING=0